{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.local/contracts/omega.model-grant.v1.schema.json",
  "title": "omega.model-grant/v1",
  "description": "Signierte Freigabe einer Modellbindung (OMG-07): Tokens, Aufrufe und Kosten pro UTC-Tag, Datenklassen, Laufzeit (max. 30 Tage). execution wie modelCapabilitiesContract (ohne deterministic). 'secret' nie remote.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grantId",
    "bindingId",
    "execution",
    "model",
    "dataClasses",
    "maxInputTokens",
    "maxOutputTokens",
    "maxCallsPerDay",
    "maxCostPerDayCents",
    "issuedAt",
    "expiresAt",
    "issuer",
    "sig"
  ],
  "properties": {
    "schema": {
      "const": "omega.model-grant/v1"
    },
    "grantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
    },
    "execution": {
      "enum": [
        "local",
        "remote"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dataClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "personal",
          "financial",
          "secret"
        ]
      }
    },
    "maxInputTokens": {
      "type": "integer",
      "minimum": 1
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 1
    },
    "maxCallsPerDay": {
      "type": "integer",
      "minimum": 1
    },
    "maxCostPerDayCents": {
      "type": "integer",
      "minimum": 0
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "issuer": {
      "type": "string",
      "pattern": "^n[0-9a-f]{16}$",
      "description": "Selbstzertifizierend: 'n' + 16 Hex-Zeichen von SHA-256(oeffentlicher Schluessel)."
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
