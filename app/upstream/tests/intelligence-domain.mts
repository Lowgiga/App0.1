import test from 'node:test';
import assert from 'node:assert/strict';
import { workSizeError } from '../lib/work-budget.ts';
import { performance } from 'node:perf_hooks';
import { emptyWork, savedWorkContract } from '../lib/work-contract.ts';
import { missionContract } from '../lib/command-contract.ts';
import { calculateNeuroScore } from '../lib/neuro.ts';
import { neuroProfileContract } from '../lib/neuro-contract.ts';
import { buildMissionGraph, getAttention, missionProgress, suggestNextFocus } from '../lib/intelligence.ts';
import { applyIntelligenceAction } from '../lib/intelligence-actions.ts';
import { withAppEvents, workChangeErrors, workReferenceErrors } from '../lib/work-updates.ts';
import { encodeSnapshot, decodeSnapshot, mergeSnapshot } from '../lib/work-snapshots.ts';
import { projectState, preserveLegacyFields } from '../lib/state-compat.ts';
import { writeIntentObserved, actionIntentObserved } from '../lib/write-reconciliation.ts';
const now = new Date('2026-09-30T13:00:00Z');
const sources = [{id:'cue-init',title:'Cue snapshot',status:'reported',file:'snapshot.md'}];
const mission = (fields: Record<string,unknown> = {}) => missionContract.parse({id:crypto.randomUUID(),title:'Test own mission',goal:'Test real own state transitions',scope:'Own local state only',project:'cue',owner:'manus',reviewer:'junior',stage:'Created',priority:'P1',output:'Verified result and checkpoint',taskIds:[],roomId:null,sourceIds:['cue-init'],evidence:'',reviewed:false,checkpoint:'',archived:false,createdAt:now.toISOString(),...fields});
const withMission = (fields: Record<string,unknown> = {}) => {const s=emptyWork();s.command.missions=[mission(fields)];return s};
const accepted = (s:ReturnType<typeof emptyWork>,a:Parameters<typeof applyIntelligenceAction>[1]) => savedWorkContract.parse(withAppEvents(s,savedWorkContract.parse(applyIntelligenceAction(s,a,now)),now));
test('bounded profiles reject negative, fractional, nonfinite and unknown values',()=>{for(const n of [-1,101,NaN,Infinity,1.5])assert.equal(neuroProfileContract.safeParse({...calculateNeuroScore({kind:'mission-close'}),dopamine:n}).success,false);assert.equal(neuroProfileContract.safeParse({...calculateNeuroScore({kind:'unknown'}),emotion:1}).success,false)});
test('rules distinguish closure, review, conflict and true unknown context',()=>{assert.equal(calculateNeuroScore({kind:'mission-stage',stage:'Done'}).dopamine,100);assert.ok(calculateNeuroScore({kind:'mission-stage',stage:'Error'}).noradrenaline>=90);assert.ok(calculateNeuroScore({kind:'mission-stage',stage:'Review'}).acetylcholin>=80);assert.equal(calculateNeuroScore({kind:'unknown'}).noradrenaline,0)});
test('v3 state migrates to v4 with computed mission and event profiles',()=>{const s=withMission({stage:'Blocked'});const e=withAppEvents(emptyWork(),s,now);const raw=structuredClone(e) as any;raw.stateVersion=3;delete raw.settings.neuro;for(const m of raw.command.missions){delete m.neuro_profile;delete m.deadlineAt}for(const event of raw.command.events){delete event.neuro_profile;delete event.neuro_context}delete raw.command.interactions;const migrated=savedWorkContract.parse(raw);assert.equal(migrated.stateVersion,4);assert.equal(migrated.command.missions[0].neuro_profile.noradrenaline,85);assert.equal(migrated.command.interactions.length,0)});
test('clients cannot raise mission weights independent of factual phase',()=>{const m=mission({neuro_profile:{acetylcholin:100,dopamine:100,serotonin:100,noradrenaline:100}});assert.equal(m.neuro_profile.noradrenaline,0);assert.notEqual(m.neuro_profile.dopamine,100)});
test('historical alarm events do not create a current conflict',()=>{const old=withMission({stage:'Blocked'});const next=withAppEvents(emptyWork(),old,now);next.command.missions[0]=mission({...next.command.missions[0],stage:'Planned'});assert.equal(getAttention(next,now.getTime()).length,0)});
test('deadline signal is derived only from an explicitly entered real time',()=>{const s=withMission();assert.equal(getAttention(s,now.getTime()).length,0);s.command.missions[0].deadlineAt=new Date(now.getTime()+1800000).toISOString();assert.equal(getAttention(s,now.getTime())[0].kind,'deadline');s.command.missions[0].stage='Done';assert.equal(getAttention(s,now.getTime()).length,0)});
test('risk acceptance produces a real immutable record and stability event, not resolution',()=>{const s=withMission({stage:'Blocked'});const risk=getAttention(s,now.getTime())[0];const next=accepted(s,{requestId:crypto.randomUUID(),action:'risk-accept',sourceId:risk.id,fingerprint:risk.fingerprint,reason:'Accept this documented blocker temporarily',expectedUpdatedAt:null});assert.equal(next.command.missions[0].stage,'Blocked');assert.equal(getAttention(next,now.getTime())[0].accepted,true);assert.equal(next.command.events.at(-1)?.kind,'risk-accepted');assert.equal(next.command.events.at(-1)?.neuro_profile.noradrenaline,0);assert.ok(next.command.events.at(-1)!.neuro_profile.serotonin>=80);assert.ok(workChangeErrors(s,next,now,['cue-init']).length)});
test('changed risk condition needs a new decision',()=>{const s=withMission({stage:'Blocked'});const risk=getAttention(s,now.getTime())[0];const next=accepted(s,{requestId:crypto.randomUUID(),action:'risk-accept',sourceId:risk.id,fingerprint:risk.fingerprint,reason:'Accept this condition for a limited period',expectedUpdatedAt:null});const changed=structuredClone(next);changed.command.missions[0]=mission({...changed.command.missions[0],stage:'Error'});assert.equal(getAttention(changed,now.getTime())[0].accepted,false)});
test('stale or forged risk fingerprint cannot be accepted',()=>{const s=withMission({stage:'Error'});assert.throws(()=>applyIntelligenceAction(s,{requestId:crypto.randomUUID(),action:'risk-accept',sourceId:'mission:'+s.command.missions[0].id,fingerprint:'forged',reason:'Invented old acceptance',expectedUpdatedAt:null},now))});
test('risk planning creates a linked task and keeps condition open',()=>{const s=withMission({stage:'Blocked'});const risk=getAttention(s,now.getTime())[0];const next=accepted(s,{requestId:crypto.randomUUID(),action:'risk-plan',sourceId:risk.id,fingerprint:risk.fingerprint,reason:'Inspect missing dependency and evidence',expectedUpdatedAt:null});const id=next.command.interactions[0].taskId!;assert.equal(next.tasks.find(t=>t.id===id)?.status,'Offen');assert.ok(next.command.missions[0].taskIds.includes(id));assert.equal(getAttention(next,now.getTime())[0].accepted,false);assert.equal(getAttention(next,now.getTime())[0].plannedTaskId,id);assert.throws(()=>applyIntelligenceAction(next,{requestId:crypto.randomUUID(),action:'risk-plan',sourceId:risk.id,fingerprint:risk.fingerprint,reason:'Duplicate risk task attempt',expectedUpdatedAt:null},now))});
test('focus recommendation is suppressed by untreated real risks',()=>{const s=withMission();assert.ok(suggestNextFocus(s.command.missions[0].id,s,now.getTime()));s.tasks[0].status='Blockiert';assert.equal(suggestNextFocus(s.command.missions[0].id,s,now.getTime()),null)});
test('following recommendation changes valid stage and produces causal server events',()=>{const s=withMission();const suggestion=suggestNextFocus(s.command.missions[0].id,s,now.getTime())!;const action={requestId:crypto.randomUUID(),action:'focus-follow' as const,missionId:suggestion.missionId,suggestionId:suggestion.id,expectedUpdatedAt:null};const next=accepted(s,action);assert.equal(next.command.missions[0].stage,'Planned');assert.ok(next.command.events.some(e=>e.kind==='mission-stage'));assert.equal(next.command.events.at(-1)?.kind,'focus-followed');assert.ok(next.command.events.at(-1)!.neuro_profile.dopamine>=40);assert.notEqual(suggestNextFocus(suggestion.missionId,next,now.getTime())?.id,suggestion.id);assert.throws(()=>applyIntelligenceAction(next,action,now))});
test('task-start honors dependency state and never auto-completes a task',()=>{const s=withMission({stage:'Working',taskIds:['tune-controls']});s.tasks[0].dependencies=[s.tasks[1].id];assert.equal(suggestNextFocus(s.command.missions[0].id,s,now.getTime()),null);s.tasks[1].status='Erledigt';s.tasks[1].reviewed=true;s.tasks[1].evidence='Explicit local review evidence';const suggestion=suggestNextFocus(s.command.missions[0].id,s,now.getTime())!;const next=accepted(s,{requestId:crypto.randomUUID(),action:'focus-follow',missionId:suggestion.missionId,suggestionId:suggestion.id,expectedUpdatedAt:null});assert.equal(next.tasks[0].status,'In Arbeit');assert.equal(next.tasks[0].reviewed,false)});
test('acceptance gates count actual remaining criteria instead of predicting time',()=>{const s=withMission({taskIds:['tune-controls']});const p=missionProgress(s.command.missions[0],s);assert.equal(p.remaining,4);assert.equal(p.steps.length,5)});
test('2D graph has namespaced nodes, valid endpoints and typed relations',()=>{const s=withMission({taskIds:['tune-controls']});const g=buildMissionGraph(s,sources);const ids=new Set(g.nodes.map(n=>n.id));assert.equal(ids.size,g.nodes.length);assert.ok(g.edges.every(e=>ids.has(e.from)&&ids.has(e.to)));assert.ok(g.edges.some(e=>e.relation==='reviews'));assert.ok(g.nodes.some(n=>n.origin==='external'))});
test('large semantic graph remains bounded and assembles quickly locally',()=>{const s=withMission();s.tasks=Array.from({length:50},(_,i)=>({...s.tasks[0],id:'large-'+i,title:'Large graph task '+i}));const start=performance.now();let g;for(let i=0;i<500;i++)g=buildMissionGraph(s,sources);const elapsed=performance.now()-start;assert.ok(g!.nodes.length>20);assert.ok(elapsed<2000);console.log(JSON.stringify({graphNodes:g!.nodes.length,graphEdges:g!.edges.length,iterations:500,elapsedMs:elapsed,scope:'local pure selector, not rendered interaction benchmark'}))});
test('unknown focus/room source and cross-domain IDs are rejected',()=>{const s=withMission();s.settings.neuro.focusMissionId=crypto.randomUUID();assert.ok(workReferenceErrors(s,['cue-init']).length);s.settings.neuro.focusMissionId=null;s.command.missions[0].id=s.tasks[0].id;assert.ok(workReferenceErrors(s,['cue-init']).length)});
test('v3 response strips every new strict-schema field and preserves history on save',()=>{const s=withAppEvents(emptyWork(),withMission(),now);const legacy=projectState(s,'3') as any;assert.equal(legacy.stateVersion,3);assert.ok(!('neuro' in legacy.settings));assert.ok(!('interactions' in legacy.command));assert.ok(!('neuro_profile' in legacy.command.missions[0]));const normalized=savedWorkContract.parse({...legacy,updatedAt:null});const changes=preserveLegacyFields(s,normalized,'3');assert.deepEqual(changes.command?.events,s.command.events)});
test('fresh target import retains completed prerequisite graph',()=>{const incoming=emptyWork();incoming.tasks[0]={...incoming.tasks[0],status:'Erledigt',reviewed:true,evidence:'Verified prerequisite result'};incoming.tasks.push({...incoming.tasks[1],id:'own-dependent',status:'Erledigt',reviewed:true,evidence:'Verified dependent task result',dependencies:[incoming.tasks[0].id]});const decoded=decodeSnapshot(encodeSnapshot(incoming,{},now));const start=performance.now();const restored=mergeSnapshot(emptyWork(),decoded,['cue-init'],now);assert.equal(restored.tasks[0].status,'Erledigt');assert.equal(restored.tasks.find(t=>t.id==='own-dependent')?.status,'Erledigt');console.log(JSON.stringify({mergeRestoreMs:performance.now()-start,scope:'local merge import, not full database restore'}))});
test('saved current tasks still win over imported colliding content',()=>{const current=emptyWork();current.updatedAt=now.toISOString();current.tasks[0].title='Own current task';const incoming=emptyWork();incoming.tasks[0].title='Incoming replacement';assert.equal(mergeSnapshot(current,incoming,['cue-init'],now).tasks[0].title,'Own current task')});
test('global UTF-8 budget rejects aggregate overflow despite legal individual fields',()=>{const s=emptyWork();s.notes=Array.from({length:100},()=>({id:crypto.randomUUID(),text:'😀'.repeat(2500),createdAt:now.toISOString()}));s.rooms=Array.from({length:12},()=>({id:crypto.randomUUID(),title:'Capacity test',agent:'manus' as const,project:'cue' as const,mode:'DEEP' as const,goal:'Capacity validation',output:'Capacity report',sources:[],status:'Aktiv' as const,createdAt:now.toISOString(),messages:Array.from({length:30},()=>({id:crypto.randomUUID(),kind:'Notiz' as const,text:'😀'.repeat(1000),createdAt:now.toISOString()}))}));const result=savedWorkContract.safeParse(s);assert.equal(result.success,true);assert.ok(workSizeError(s)?.includes('1.750.000'))});
test('lost response reconciliation confirms stable IDs instead of duplicating notes',()=>{const before=emptyWork();const proposed=structuredClone(before);proposed.notes.push({id:crypto.randomUUID(),text:'Unique own note after response loss',createdAt:now.toISOString()});const stored=structuredClone(proposed);stored.updatedAt=now.toISOString();assert.equal(writeIntentObserved(before,proposed,stored),true);assert.equal(writeIntentObserved(before,proposed,before),false);stored.notes[0].text='Different text';assert.equal(writeIntentObserved(before,proposed,stored),false)});
test('lost action response is reconciled by appended server interaction record',()=>{const s=withMission();const suggestion=suggestNextFocus(s.command.missions[0].id,s,now.getTime())!;const a={requestId:crypto.randomUUID(),action:'focus-follow' as const,missionId:suggestion.missionId,suggestionId:suggestion.id,expectedUpdatedAt:null};assert.equal(actionIntentObserved(s,a,accepted(s,a)),true);assert.equal(actionIntentObserved(s,a,s),false)});
test('accepted risk follows exact scope even after event log rotation',()=>{const s=withMission({stage:'Blocked'});const r=getAttention(s,now.getTime())[0];const next=accepted(s,{requestId:crypto.randomUUID(),action:'risk-accept',sourceId:r.id,fingerprint:r.fingerprint,reason:'Accept the current exact scope only',expectedUpdatedAt:null});next.command.events=[];assert.equal(getAttention(next,now.getTime())[0].accepted,true);next.command.missions[0].scope='Materially different operation with new data';assert.equal(getAttention(next,now.getTime())[0].accepted,false)});
test('lost room response remains confirmed after a subsequent contribution',()=>{const before=emptyWork();const room={id:crypto.randomUUID(),title:'Own room',agent:'manus' as const,project:'cue' as const,mode:'DEEP' as const,goal:'Review own data',output:'Review evidence',sources:[],status:'Aktiv' as const,createdAt:now.toISOString(),messages:[] as {id:string,kind:'Notiz',text:string,createdAt:string}[]};before.rooms.push(room);const proposed=structuredClone(before);proposed.rooms[0].messages.push({id:crypto.randomUUID(),kind:'Notiz',text:'My saved contribution',createdAt:now.toISOString()});const latest=structuredClone(proposed);latest.updatedAt=now.toISOString();latest.rooms[0].messages.push({id:crypto.randomUUID(),kind:'Notiz',text:'Subsequent independent contribution',createdAt:now.toISOString()});assert.equal(writeIntentObserved(before,proposed,latest),true);latest.rooms[0].messages[0].text='Changed original contribution';assert.equal(writeIntentObserved(before,proposed,latest),false)});
test('action confirmation requires exact request and original condition',()=>{const s=withMission({stage:'Blocked'});const r=getAttention(s,now.getTime())[0];const a={requestId:crypto.randomUUID(),action:'risk-accept' as const,sourceId:r.id,fingerprint:r.fingerprint,reason:'Accept the precise current condition',expectedUpdatedAt:null};const latest=accepted(s,a);assert.equal(actionIntentObserved(s,a,latest),true);assert.equal(actionIntentObserved(s,{...a,requestId:crypto.randomUUID()},latest),false);assert.equal(actionIntentObserved(s,{...a,fingerprint:'different condition'},latest),false)});
test('automatic modal is separate opt-in from a nonmodal priority hint',()=>{const s=emptyWork();assert.equal(s.settings.neuro.autoPriority,false);assert.equal(s.settings.neuro.autoConsole,false);s.settings.neuro.autoPriority=true;assert.equal(savedWorkContract.parse(s).settings.neuro.autoConsole,false)});
test('new room response remains confirmed after another user contribution',()=>{const before=emptyWork();const proposed=structuredClone(before);proposed.rooms.push({id:crypto.randomUUID(),title:'New own room',agent:'manus',project:'cue',mode:'DEEP',goal:'Review saved state',output:'Review evidence',sources:[],status:'Aktiv',createdAt:now.toISOString(),messages:[]});const latest=structuredClone(proposed);latest.updatedAt=now.toISOString();latest.rooms[0].messages.push({id:crypto.randomUUID(),kind:'Notiz',text:'Subsequent contribution',createdAt:now.toISOString()});assert.equal(writeIntentObserved(before,proposed,latest),true)});
test('content digest agrees with Node SHA-256 across padding, Unicode and escaping',async()=>{const {contentDigest}=await import('../lib/content-digest.ts');const {createHash}=await import('node:crypto');for(const value of ['', 'abc', 'ä😀漢字', '\\'.repeat(10000), ...Array.from({length:140},(_,n)=>'x'.repeat(n))])assert.equal(contentDigest(value),'sha256:'+createHash('sha256').update(value).digest('hex'))});
test('long legal escaped content retains compact actionable risk revision',()=>{const s=withMission({stage:'Blocked',goal:'\\'.repeat(2000),scope:'\\'.repeat(1500),evidence:'\\'.repeat(3000),checkpoint:'\\'.repeat(3000)});const r=getAttention(s,now.getTime())[0];assert.equal(r.fingerprint.length,71);assert.ok(accepted(s,{requestId:crypto.randomUUID(),action:'risk-accept',sourceId:r.id,fingerprint:r.fingerprint,reason:'Explicitly accept this exact large scope',expectedUpdatedAt:null}).command.interactions.length===1)});
