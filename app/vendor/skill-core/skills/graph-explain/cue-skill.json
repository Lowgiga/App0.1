{
  "namespace": "cue.command-mesh.skill/v1",
  "id": "cue.graph-explain",
  "version": "1.0.0",
  "name": "graph-explain",
  "description": "Graph erklären: Ermittle Verbindungen und ungültige Kanten eines explizit übergebenen kleinen Mesh-Graphen.",
  "triggers": {
    "intents": [
      "graph-explain"
    ],
    "anyTags": [
      "graph",
      "explain"
    ],
    "allTags": [],
    "excludeTags": [
      "execute",
      "delete",
      "install",
      "external-write"
    ],
    "nodeTypes": [
      "agent",
      "mission",
      "tool",
      "source",
      "graph"
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100
            },
            "label": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "id",
            "label"
          ],
          "additionalProperties": false
        },
        "maxItems": 1000
      },
      "edges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 100
            },
            "target": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "source",
            "target"
          ],
          "additionalProperties": false
        },
        "maxItems": 1000
      }
    },
    "required": [
      "nodes",
      "edges"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "offline-deterministic"
        ]
      },
      "nodeCount": {
        "type": "integer",
        "minimum": 0
      },
      "edgeCount": {
        "type": "integer",
        "minimum": 0
      },
      "danglingEdges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 100
            },
            "target": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "source",
            "target"
          ],
          "additionalProperties": false
        },
        "maxItems": 1000
      },
      "adjacency": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100
            },
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "outbound": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              },
              "maxItems": 1000
            },
            "inbound": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              },
              "maxItems": 1000
            }
          },
          "required": [
            "id",
            "label",
            "outbound",
            "inbound"
          ],
          "additionalProperties": false
        },
        "maxItems": 1000
      }
    },
    "required": [
      "mode",
      "nodeCount",
      "edgeCount",
      "danglingEdges",
      "adjacency"
    ],
    "additionalProperties": false
  },
  "tools": [
    {
      "id": "core.graph.explain",
      "effect": "local-compute",
      "authentication": "none",
      "permissions": [
        "compute:graph"
      ]
    }
  ],
  "handler": "graph-explain",
