{
  "namespace": "cue.command-mesh.skill/v1",
  "id": "cue.mission-check",
  "version": "1.0.0",
  "name": "mission-check",
  "description": "Mission prüfen: Prüfe ausschließlich eine bereitgestellte Mission mit ihren Schritten.",
  "triggers": {
    "intents": [
      "mission-check"
    ],
    "anyTags": [
      "mission",
      "audit"
    ],
    "allTags": [],
    "excludeTags": [
      "execute",
      "delete",
      "install",
      "external-write"
    ],
    "nodeTypes": [
      "mission"
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 200
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 200
