          "offline-deterministic"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 200
      },
      "stepCount": {
        "type": "integer",
        "minimum": 0
      },
      "completedCount": {
        "type": "integer",
        "minimum": 0
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 500
        },
        "maxItems": 1001
      }
    },
    "required": [
      "mode",
      "title",
      "stepCount",
      "completedCount",
      "issues"
    ],
    "additionalProperties": false
  },
  "tools": [
    {
      "id": "core.mission.check",
      "effect": "local-compute",
      "authentication": "none",
      "permissions": [
        "compute:mission"
      ]
    }
