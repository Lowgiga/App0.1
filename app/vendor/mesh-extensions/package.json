{
  "name": "cue-mesh-graph-explorer-extension",
  "version": "0.1.0-candidate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register.mjs --test tests/*.test.ts tests/*.test.tsx",
    "build": "npm run typecheck && vite build && vite build --config vite.demo.config.ts && tsc -p tsconfig.types.json",
    "dev": "vite --config vite.demo.config.ts --host 127.0.0.1 --port 4175",
    "preview": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 4175"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "happy-dom": "20.14.5"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/library/graph-explorer.js"
    },
    "./styles.css": "./dist/library/graph-explorer.css"
  }
}
